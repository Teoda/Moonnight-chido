# Dirección del back de Express (moonlight-db). El servidor de SvelteKit le reenvía /api/*.
API_URL=http://localhost:4000

# ── Solo en producción (npm run build && npm start) ──
# Puerto y dirección pública del sitio (adapter-node). El back debe tener esta misma dirección en ALLOWED_ORIGINS.
PORT=3000
ORIGIN=http://localhost:3000
# Si hay un proxy (Nginx/Caddy/hosting) delante, para conocer la IP y el protocolo reales:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# PROTOCOL_HEADER=X-Forwarded-Proto
