DATABASE_URL="mysql://moonlight:moonlight_pass@127.0.0.1:3309/moonlight"

NODE_ENV=development
PORT=4000
# Orígenes (esquema+dominio) que pueden usar la API con cookies. En producción deben ser https://
ALLOWED_ORIGINS=http://localhost:3000
# Mínimo 32 caracteres. Genera uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Cuántos proxies hay delante (Nginx/Caddy/hosting = 1)
TRUST_PROXY=1
# Pago de anticipo simulado (por defecto solo en desarrollo; actívalo a mano para la presentación)
PAGOS_SIMULADOS=
# Solo para pruebas: abre los 7 días las 24 h al correr el seed (npm run db:seed). Déjalo vacío para el horario real.
HORARIO_24H=
