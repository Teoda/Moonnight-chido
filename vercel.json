{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "moonlight-db": {
      "root": "moonlight-db",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "moonlight-front": {
      "root": "moonlight-front",
      "framework": "sveltekit-1"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "moonlight-db" } },
    { "source": "/(.*)", "destination": { "service": "moonlight-front" } }
  ]
}
